# ============================================
# DigiStall Environment Configuration
# ============================================
# Copy this file to .env and configure for your environment
# See docs/DATABASE_SETUP.md for detailed setup instructions

# ============================================
# DATABASE CONFIGURATION
# ============================================

# DigitalOcean Cloud Database (Production & Shared Development)
# This is the default configuration for using the cloud database
# IMPORTANT: Your IP must be whitelisted in DigitalOcean Trusted Sources
# See: https://cloud.digitalocean.com/databases/dbaas-db-2078449-do-user-29954926-0/settings

DB_HOST=dbaas-db-2078449-do-user-29954926-0.f.db.ondigitalocean.com
DB_PORT=25060
DB_NAME=naga_stall
DB_USER=doadmin
DB_PASSWORD=AVNS_hxkemfGwzsOdj4pbu35
DB_SSL=true  # REQUIRED for DigitalOcean - do not change to false

# Local Database (Alternative for offline development)
# Uncomment these lines and comment out the cloud config above to use local MySQL
# You need to have MySQL running locally on port 3301

# DB_HOST=localhost
# DB_PORT=3301
# DB_NAME=naga_stall
# DB_USER=root
# DB_PASSWORD=
# DB_SSL=false

# Quick Switch Commands:
# npm run db:cloud  - Switch to DigitalOcean cloud database
# npm run db:local  - Switch to local database
# npm run db:test   - Test your database connection

# ============================================
# NODE ENVIRONMENT
# ============================================

# Environment mode
# Options: development, production
NODE_ENV=production

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================

# Global API limit (e.g., 300 requests per 15 minutes)
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300

# Auth / Sensitive limit (e.g., 3 requests per 15 minutes)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=3

# ============================================
# JWT AUTHENTICATION
# ============================================

# JWT Secret for access tokens
# IMPORTANT: Change these in production!
JWT_SECRET=your_super_secure_jwt_secret_change_this_in_production

# JWT Secret for refresh tokens
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_change_this_in_production

# JWT Expiration Times
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# ============================================
# CORS CONFIGURATION
# ============================================

# Main CORS origin
CORS_ORIGIN=http://digi-stall.com

# Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://digi-stall.com,http://68.183.154.125,http://localhost:3000,http://localhost:5173

# ============================================
# FILE UPLOADS
# ============================================

# Upload directory path
UPLOAD_PATH=/opt/digistall/uploads

# Maximum file size (in bytes)
# 5MB = 5242880, 10MB = 10485760
MAX_FILE_SIZE=10485760

# ============================================
# SERVER CONFIGURATION
# ============================================

# API Server Ports
PORT_WEB=5000
PORT_MOBILE=5001

# Frontend Port (for local development)
PORT_FRONTEND=3000

# ============================================
# LOGGING
# ============================================

# Log level: error, warn, info, debug
LOG_LEVEL=info

# ============================================
# PRODUCTION DEPLOYMENT
# ============================================

# Production domain
DOMAIN=digi-stall.com

# Production server IP
SERVER_IP=68.183.154.125

# ============================================
# EMAILJS CONFIGURATION (Web Frontend)
# ============================================
# Get these values from https://www.emailjs.com/
# Note: EmailJS only works from browser (web), not from backend (mobile)
# VITE_ prefix exposes them to the Vite frontend build

VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_APPROVE_TEMPLATE_ID=your_approve_template_id
VITE_EMAILJS_DECLINE_TEMPLATE_ID=your_decline_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SENDER_EMAIL=your_sender_email@example.com
VITE_EMAILJS_SENDER_NAME=Stall Management System

# ============================================
# NOTES
# ============================================

# Database Setup:
# 1. For cloud database: Add your IP to DigitalOcean Trusted Sources
# 2. For local database: Install and run MySQL on your machine
# 3. Test connection: npm run db:test
# 4. Full setup guide: docs/DATABASE_SETUP.md

# Environment Switching:
# - Files: .env.local (local), .env.production (cloud)
# - Switch: npm run db:local or npm run db:cloud
# - Check current: npm run db:switch

# Security:
# - Never commit .env files to git (they're in .gitignore)
# - Change default JWT secrets in production
# - Rotate database password periodically
# - Use specific IP addresses in Trusted Sources (not 0.0.0.0/0)

# Support:
# - Documentation: docs/DATABASE_SETUP.md
# - Troubleshooting: docs/DATABASE_SETUP.md#troubleshooting
# - DigitalOcean Dashboard: https://cloud.digitalocean.com/
