# ============================================
# DigiStall Mobile (Expo) Environment Configuration
# ============================================
# Copy this file to .env in the FRONTEND/MOBILE directory.
# Variables prefixed with EXPO_PUBLIC_ are bundled into the app by Expo/Metro.
# NEVER put server-side secrets here — these end up in the app bundle.

# ============================================
# BACKEND API URLS
# ============================================
# Development — your local machine IP (not localhost — mobile can't reach it)
EXPO_PUBLIC_API_URL_LOCAL=http://192.168.1.100:5001/api

# Production — DigitalOcean Droplet
EXPO_PUBLIC_API_URL_PROD=http://your_droplet_ip:5001/api

