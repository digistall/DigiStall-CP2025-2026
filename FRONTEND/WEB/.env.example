# ============================================
# DigiStall Web Frontend Environment Configuration
# ============================================
# Copy this file to .env (for dev) or .env.production (for prod builds).
# Variables prefixed with VITE_ are exposed to the browser by Vite.
# NEVER put secrets here that must stay server-side.

# ============================================
# BACKEND API URL
# ============================================
# Development (backend running locally)
VITE_API_URL=http://localhost:5000/api

# Production — use a relative path if nginx proxies /api to the backend
# VITE_API_URL=/api

# ============================================
# IMAGE / STATIC ASSETS BASE URL
# ============================================
VITE_IMAGE_BASE_URL=http://localhost:5000

# ============================================
# ENVIRONMENT
# ============================================
VITE_ENV=development

# ============================================
# EMAILJS CONFIGURATION
# ============================================
# EmailJS runs in the browser — these values are intentionally public
# (EmailJS is designed this way). Get them from: https://www.emailjs.com/
#
# ⚠️ Even though these are "public" keys, keep them out of source code.
#    Vite inlines them at build time, so only committed .env files matter.
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_APPROVE_TEMPLATE_ID=your_emailjs_approve_template_id
VITE_EMAILJS_DECLINE_TEMPLATE_ID=your_emailjs_decline_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SENDER_EMAIL=your_sender_email@example.com
VITE_EMAILJS_SENDER_NAME=Stall Management System
