# ============================================
# DigiStall Web Frontend Environment Configuration
# ============================================
# Copy this file to .env (for dev) or .env.production (for prod builds).
# Variables prefixed with VITE_ are exposed to the browser by Vite.
# NEVER put secrets here that must stay server-side.

# ============================================
# BACKEND API URL
# ============================================
# Development (backend running locally)
VITE_API_URL=http://localhost:5000/api

# Production — use a relative path if nginx proxies /api to the backend
# VITE_API_URL=/api

# ============================================
# IMAGE / STATIC ASSETS BASE URL
# ============================================
VITE_IMAGE_BASE_URL=http://localhost:5000

# ============================================
# ENVIRONMENT
# ============================================
VITE_ENV=development

# ============================================
